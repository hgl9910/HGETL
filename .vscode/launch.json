{
    "version": "0.2.0",
    "configurations": [
      
      {
      "type": "cortex-debug",
      "request": "launch",
      "name": "Debug J-Link",
      "cwd": "${workspaceRoot}",
      "executable": "${workspaceRoot}/build/Blinky.elf",
      "serverpath": "C:/Programme/SEGGER/JLink/JLinkGDBServerCL.exe", 
